# 复制为 .env 后填真实值：cp .env.example .env
# 配完执行 python -m services.monitor --show-config 自检
#
# 注意：值后面不要写行内注释（# 会被当成值的一部分），注释请单独一行。

# ---------- 必填 ----------
# Web/API 访问密钥（未设置时所有 /api/* 返回 503）
WEB_API_KEY=change-me

# 告警机器人地址；类型可选 feishu / dingtalk / wecom / custom
WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_TOKEN
WEBHOOK_TYPE=feishu
WEBHOOK_SOURCE=balance-alert

# ---------- Provider 密钥 ----------
# 变量名规则：{PROVIDER}_API_KEY，config.json 里无需再写 api_key。
# 同一 provider 有多个账号时用 {PROVIDER}_{序号}_API_KEY，序号对应 config.json 中的出现顺序。
OPENROUTER_API_KEY=sk-or-v1-xxx
UNIAPI_API_KEY=uniapi-xxx
WXRANK_API_KEY=xxx
TIKHUB_API_KEY=xxx
# 火山引擎与阿里云用 "ID:Secret" 形式
VOLC_1_API_KEY=AKLT_ACCESS_KEY:SECRET_KEY_BASE64
VOLC_2_API_KEY=AKLT_ACCESS_KEY:SECRET_KEY_BASE64
ALIYUN_1_API_KEY=ACCESS_KEY_ID:ACCESS_KEY_SECRET

# 邮箱扫描用（config.json 里写 ${EMAIL_PASSWORD} 引用）
# EMAIL_PASSWORD=

# ---------- 可选功能开关（默认全关）----------
# ENABLE_DATABASE=true          历史记录与动态配置的前提
# ENABLE_DYNAMIC_CONFIG=true    业务清单改从数据库读，可用 Web UI 维护
# ENABLE_HISTORY_API=true       历史数据查询接口
# ENABLE_SUBSCRIPTIONS=true     订阅续费提醒
# ENABLE_PROMETHEUS=true        Prometheus metrics（默认端口 9100）
# ENABLE_WEB_ALARM=true         Web 后台刷新也发真实告警（默认只有定时任务发）

# ---------- 可选调优 ----------
# BALANCE_REFRESH_INTERVAL_SECONDS=3600   Web 后台刷新间隔
# MAX_CONCURRENT_CHECKS=20                并发检查数，1-50
# ALERT_COOLDOWN_SECONDS=86400            同一项目告警冷却
# SUBSCRIPTION_ALERT_COOLDOWN_SECONDS=86400
# RESPONSE_CACHE_TTL=300                  余额结果缓存，防手动刷新打爆上游
# LOG_LEVEL=INFO                          DEBUG / INFO / WARNING / ERROR
# LOG_FORMAT=text                         text 或 json
# LOG_FILE=logs/balance_alert.log

# ---------- 数据库（ENABLE_DATABASE=true 时生效）----------
# SQLite（默认）/ PostgreSQL / MySQL 三选一：
# DATABASE_URL=sqlite:///./data/balance_alert.db
# DATABASE_URL=postgresql://user:pass@host:5432/balance_alert
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/balance_alert?charset=utf8mb4
#
# 设置后数据库里的 api_key / 邮箱密码会加密存储，生成密钥：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONFIG_ENCRYPTION_KEY=

# ---------- Grafana（仅 docker compose --profile monitoring 需要）----------
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
