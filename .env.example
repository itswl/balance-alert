# 复制为 .env 后填真实值：cp .env.example .env
# 配完执行 ./balance-alert -show-config 自检
#
# 注意：值后面不要写行内注释（# 会被当成值的一部分），注释请单独一行。

# ---------- 必填 ----------
# Web/API 访问密钥（未设置时所有 /api/* 返回 503）
WEB_API_KEY=change-me

# 告警机器人地址；类型可选 feishu / dingtalk / wecom / custom
WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_TOKEN
WEBHOOK_TYPE=feishu
WEBHOOK_SOURCE=balance-alert

# ---------- Provider 密钥 ----------
# 变量名规则：{PROVIDER}_API_KEY。设了就会自动成为一个受监控项目，没有配置文件这一层；
# 阈值写 {PROVIDER}_THRESHOLD，分组写 {PROVIDER}_OWNER_PROJECT，都可省。
# 同一 provider 多个账号用 {PROVIDER}_{序号}_API_KEY，项目名自动变成 volc-1、volc-2。
OPENROUTER_API_KEY=sk-or-v1-xxx
UNIAPI_API_KEY=uniapi-xxx
WXRANK_API_KEY=xxx
TIKHUB_API_KEY=xxx
DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_THRESHOLD=50                   低于 50 元告警；不填则只看不告警
# 智谱开放平台的 API Key（id.secret 形式），查的是 Coding Plan 剩余配额百分比
GLM_API_KEY=xxx.xxx
# 火山引擎与阿里云用 "ID:Secret" 形式
VOLC_1_API_KEY=AKLT_ACCESS_KEY:SECRET_KEY_BASE64
VOLC_2_API_KEY=AKLT_ACCESS_KEY:SECRET_KEY_BASE64
ALIYUN_1_API_KEY=ACCESS_KEY_ID:ACCESS_KEY_SECRET

# ---------- 邮箱扫描（三个都设了就自动纳入扫描）----------
# EMAIL_HOST=imap.example.com
# EMAIL_USERNAME=me@example.com
# EMAIL_PASSWORD=
# EMAIL_PORT=993                          默认 993
# EMAIL_USE_SSL=true                      默认 true
# EMAIL_NAME=工作邮箱                      默认用账号名
# 多个邮箱用 EMAIL_1_HOST / EMAIL_2_HOST …，其余变量同理带序号
# EMAIL_ALERT_KEYWORDS=                   逗号分隔，整体替换默认关键词表
# EMAIL_EXTRA_ALERT_KEYWORDS=             逗号分隔，在默认词表上追加

# ---------- 可选功能开关（默认全关）----------
# ENABLE_DATABASE=true          历史记录与动态配置的前提
# ENABLE_DYNAMIC_CONFIG=true    业务清单改从数据库读，可用 Web UI 维护
# ENABLE_HISTORY_API=true       历史数据查询接口
# ENABLE_SUBSCRIPTIONS=true     订阅续费提醒
# ENABLE_PROMETHEUS=true        Prometheus metrics（默认端口 9100）
# ENABLE_WEB_ALARM=true         Web 后台刷新也发真实告警（默认只有定时任务发）

# ---------- 可选调优 ----------
# BALANCE_REFRESH_INTERVAL_SECONDS=3600   Web 后台刷新间隔（只查不发告警，除非 ENABLE_WEB_ALARM=true）
# ALERT_SCHEDULE=09:00,15:00              余额+订阅真实告警检查时刻，按容器时区，多个用逗号分隔，填 off 关闭
# EMAIL_SCAN_SCHEDULE=10:00               定时邮箱扫描时刻（发送真实告警），填 off 关闭
# EMAIL_SCAN_DAYS=1                       定时邮箱扫描覆盖最近几天，1-30
# WEEKLY_REPORT_SCHEDULE=Mon 09:00        周报推送时刻，格式「星期 时刻」，星期可写 Mon/周一/1，填 off 关闭

# ---------- 消耗与跑道（需 ENABLE_DATABASE=true 攒历史；阈值设 0 关闭该项告警）----------
# BURN_RATE_WINDOW_DAYS=7                 算日均消耗看最近几天
# RUNWAY_ALERT_DAYS=7                     按当前速率还能用几天就告警
# SPEND_SPIKE_RATIO=3                     今日消耗达到日常中位数的几倍算突增
# SPEND_SPIKE_MIN_AMOUNT=1                今日消耗低于这个绝对值不报突增
# MAX_CONCURRENT_CHECKS=20                并发检查数，1-50
# ALERT_COOLDOWN_SECONDS=86400            同一项目告警冷却
# SUBSCRIPTION_ALERT_COOLDOWN_SECONDS=86400
# RESPONSE_CACHE_TTL=300                  余额结果缓存，防手动刷新打爆上游
# LOG_LEVEL=INFO                          DEBUG / INFO / WARNING / ERROR
# LOG_FORMAT=text                         text 或 json
# LOG_FILE=logs/balance_alert.log
# SHUTDOWN_DELAY_SECONDS=0                收到 SIGTERM 后先继续服务几秒再关；K8s 里建议 15

# ---------- 数据库（ENABLE_DATABASE=true 时生效）----------
# SQLite（默认）/ PostgreSQL / MySQL 三选一：
# DATABASE_URL=sqlite:///./data/balance_alert.db
# DATABASE_URL=postgresql://user:pass@host:5432/balance_alert
# DATABASE_URL=mysql://user:pass@host:3306/balance_alert?charset=utf8mb4
# scheme 里带 +驱动名 后缀（mysql+pymysql 这种）也认，只取 + 前面的部分
#
# 设置后数据库里的 api_key / 邮箱密码会加密存储。生成密钥：
#   openssl rand -base64 32 | tr '+/' '-_'
# 不想折腾的话，随便写个足够长的口令也行——程序会取它的 SHA-256 当密钥。
# CONFIG_ENCRYPTION_KEY=

# ---------- Grafana（仅叠加 docker-compose.monitoring.yml 时需要）----------
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me
